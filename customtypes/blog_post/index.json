{
  "id": "blog_post",
  "label": "Blog Post",
  "format": "page",
  "repeatable": true,
  "status": true,
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID",
          "placeholder": "unique-blog-post-url"
        }
      },
      "title": {
        "type": "StructuredText",
        "config": {
          "label": "Title",
          "placeholder": "Blog post title...",
          "single": "heading1"
        }
      },
      "featured_image": {
        "type": "Image",
        "config": {
          "label": "Featured Image",
          "constraint": {},
          "thumbnails": []
        }
      },
      "excerpt": {
        "type": "StructuredText",
        "config": {
          "label": "Excerpt",
          "placeholder": "A short description of the blog post...",
          "single": "paragraph"
        }
      },
      "publish_date": {
        "type": "Date",
        "config": {
          "label": "Publish Date"
        }
      },
      "category": {
        "type": "Select",
        "config": {
          "label": "Category",
          "placeholder": "Select a category",
          "options": ["Product", "Development", "Management", "Leadership"]
        }
      },
      "content": {
        "type": "StructuredText",
        "config": {
          "label": "Main Description",
          "placeholder": "Main blog post description...",
          "allowTargetBlank": true,
          "multi": "paragraph,preformatted,heading1,heading2,heading3,heading4,heading5,heading6,strong,em,hyperlink,image,embed,list-item,o-list-item,rtl"
        }
      },
      "content_sections": {
        "type": "Group",
        "config": {
          "label": "Content Sections",
          "fields": {
            "section_subtitle": {
              "type": "Text",
              "config": {
                "label": "Section Subtitle",
                "placeholder": "Enter subtitle for this section"
              }
            },
            "section_description": {
              "type": "StructuredText",
              "config": {
                "label": "Section Description",
                "placeholder": "Enter description for this section...",
                "allowTargetBlank": true,
                "multi": "paragraph,preformatted,heading3,heading4,strong,em,hyperlink,list-item,o-list-item,rtl"
              }
            },
            "section_image": {
              "type": "Image",
              "config": {
                "label": "Section Image",
                "constraint": {},
                "thumbnails": []
              }
            }
          }
        }
      },
      "tags": {
        "type": "Group",
        "config": {
          "label": "Tags",
          "fields": {
            "tag": {
              "type": "Text",
              "config": {
                "label": "Tag",
                "placeholder": "Tag name"
              }
            }
          }
        }
      }
    },
    "SEO": {
      "meta_title": {
        "type": "Text",
        "config": {
          "label": "Meta Title",
          "placeholder": "SEO title for the blog post"
        }
      },
      "meta_description": {
        "type": "Text",
        "config": {
          "label": "Meta Description",
          "placeholder": "SEO description for the blog post"
        }
      },
      "meta_image": {
        "type": "Image",
        "config": {
          "label": "Meta Image",
          "constraint": {},
          "thumbnails": []
        }
      }
    }
  }
}
